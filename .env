# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL Database (Local or Docker)
DATABASE_URL="postgresql://studenthub_user:studenthub_secret_pass@localhost:5432/studenthub_db?schema=public"

# Authentication Secrets
JWT_ACCESS_SECRET=studenthub_super_secret_jwt_access_key_change_in_production_min_64_chars!
JWT_REFRESH_SECRET=studenthub_super_secret_jwt_refresh_key_change_in_production_min_64_chars!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
